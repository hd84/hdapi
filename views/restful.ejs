<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RESTful API Test</title>
  <style>
    body {
      font-family: 'Inter', 'Noto Sans KR', 'Roboto', Arial, sans-serif;
      background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
      color: #222;
      max-width: 1280px;
      margin: 0 auto;
      padding: 10px 16px;
      min-height: 100vh;
    }

    .container {
      display: flex;
      gap: 32px;
      background: #fff;
      border-radius: 24px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.08);
      padding: 32px;
      margin-top: 24px;
    }

    .split {
      flex: 1;
      overflow-y: auto;
      padding: 0 16px;
      box-sizing: border-box;
      border-radius: 16px;
      background: none;
    }

    .left {
      background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      max-width: 330px;
      min-height: 700px;
      max-height: 700px;
      padding: 24px 16px;
    }
    .left li {
      list-style: none;
      margin-bottom: 2px;
      border-radius: 8px;
      transition: background 0.2s;
    }
    .left li a {
      text-decoration: none;
      color: #2563eb;
      font-weight: 500;
      padding: 8px 12px;
      display: block;
      border-radius: 8px;
      transition: background 0.2s, color 0.2s;
    }
    .left li:hover, .left li a:hover {
      background: #f3f6fa;
      /* 효과 축소: border-radius, padding, margin, letter-spacing 제거 */
    }
    .left li:hover a {
      background: #f3f6fa;
      color: #2563eb;
    }
    .left li a:hover {
      background: #f3f6fa;
      color: #2563eb;
    }
    .modern-input {
      width: 100%;
      padding: 3px 6px;
      border-radius: 4px;
      border: 1px solid #e0e7ef;
      font-size: 0.90rem;
      margin-bottom: 2px;
      background: #f8fafc;
      transition: border 0.18s, box-shadow 0.18s, background 0.18s;
      outline: none;
      box-sizing: border-box;
      color: #222;
      font-family: 'Inter', 'Noto Sans KR', 'Roboto', Arial, sans-serif;
      box-shadow: 0 1px 2px rgba(37,99,235,0.04);
    }
    .modern-input:focus {
      border: 1.5px solid #2563eb;
      box-shadow: 0 4px 16px rgba(37,99,235,0.10);
      background: #fff;
    }
    .modern-input::placeholder {
      color: #94a3b8;
      opacity: 1;
      font-size: 0.98em;
    }
      

    #apiForm {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    #method, #apiForm button {
      padding: 8px 16px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
      background: #fff;
      transition: box-shadow 0.2s, border 0.2s;
    }
    #apiForm button {
      background: linear-gradient(90deg, #2563eb 0%, #60a5fa 100%);
      color: #fff;
      font-weight: 600;
      border: none;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(37,99,235,0.08);
    }
    #apiForm button:hover {
      background: linear-gradient(90deg, #1e40af 0%, #2563eb 100%);
    }
    label {
      font-weight: 500;
      margin-bottom: 4px;
      color: #334155;
    }
    .input-label {
      font-weight: 500;
      margin-bottom: 2px;
      color: #334155;
      font-size: 0.9rem;
    }
    .input-desc {
      font-size: 0.75rem;
      color: #64748b;
      font-weight: 400;
    }

    .center {
      flex: 0.6;
    }

    .right {
      flex: 1.4;
      background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      padding: 24px 16px;
      border-radius: 16px;
      min-height: 700px;
    }
    .right h2 {
      margin-top: 0;
      font-size: 1.2rem;
      color: #2563eb;
    }
    #result {
      background: #f1f5f9;
      padding: 16px;
      border-radius: 12px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.04);
      font-size: 1rem;
      margin-top: 8px;
      word-break: break-all;
      max-height: 700px;
      overflow-y: auto;
    }

    h1 {
      text-align: center;
      font-size: 1.6rem;
      font-weight: 700;
      letter-spacing: -1px;
      color: #2563eb;
      margin-bottom: 0.5em;
      margin-top: 0;
      text-shadow: 0 2px 8px rgba(37,99,235,0.08);
    }
    .spinner {
      border: 3px solid rgba(37, 99, 235, 0.1);
      border-left-color: #2563eb;
      border-radius: 50%;
      width: 24px;
      height: 24px;
      animation: spin 1s linear infinite;
      display: none;
      margin-left: 12px;
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .renderjson {
      font-family: 'Inter', 'Noto Sans KR', 'Roboto', Arial, sans-serif;
      font-size: 0.8rem;
    }
    .renderjson .key { color: #881391; }
    .renderjson .string { color: #c41a16; }
    .renderjson .number { color: #1c00cf; }
    .renderjson .boolean { color: #1c00cf; }
    .renderjson .null { color: #808080; }
    .renderjson a { text-decoration: none; }
    .response-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .copy-btn {
      background: #fff;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      padding: 6px 12px;
      font-size: 0.85rem;
      cursor: pointer;
      color: #334155;
      transition: all 0.2s;
      display: none;
    }
    .copy-btn:hover {
      background: #f1f5f9;
      color: #2563eb;
      border-color: #2563eb;
    }
    .cate-btn {
      padding: 4px 8px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      background: #fff;
      cursor: pointer;
      font-size: 0.75rem;
      color: #334155;
      transition: all 0.2s;
    }
    .cate-btn:hover {
      background: #f1f5f9;
      color: #2563eb;
      border-color: #2563eb;
    }
    .cate-btn.active {
      background: #2563eb;
      color: #fff;
      border-color: #2563eb;
    }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/renderjson@1.4.0/renderjson.min.js"></script>
</head>

<body>
  <h1>Game REST API <%= `${version}` %> </h1>
  <div class="container">
    <div id="hiddenData" style="display: none;">
      <%- JSON.stringify(mapRoute) %>
    </div>    
    <div class="split left">
      <label for="endpoint">Endpoint:</label>      
      <div style="margin-bottom: 10px; display: flex; gap: 4px; flex-wrap: wrap;">
        <button type="button" class="cate-btn active" onclick="filterEndpoints('all', this)">All</button>
        <% Object.keys(mapRoute).forEach(key_cate=> { %>
          <button type="button" class="cate-btn" onclick="filterEndpoints('<%= key_cate %>', this)"><%= key_cate %></button>
        <% }); %>
      </div>
      <% Object.keys(mapRoute).forEach(key_cate=> { %>
        <% Object.keys(mapRoute[key_cate]).forEach(key_api=> { %>
          <% 
            let str_endpoint = `/${key_cate}/${key_api}`;
            if( key_cate == "root"){
              str_endpoint = `/${key_api}`
            } 
          %>
          <li class="endpoint-item" data-cate="<%= key_cate %>" onclick="endpointclick(<%= `'${key_cate}', '${key_api}'` %>)"><a href="#"><%= `${str_endpoint}` %></a></li>          
        <% }); %>
      <% }); %>
    </div>
    <div class="split center">
      <form id="apiForm">
        <select id="method">
          <option value="POST">POST</option>
          <option value="GET">GET</option>
          <!--
          <option value="PUT">PUT</option>
          <option value="DELETE">DELETE</option>
          -->
        </select>
        <div id="selectedEndpoint" style="margin-bottom: 5px; font-weight: bold; color: #2563eb;"></div>
        <label for="body">Request Param</label>
        <div id="div_request"></div>
        <div style="display: flex; align-items: center;">
          <button type="submit" style="flex-grow: 1;">Send Request</button>
          <div id="loadingSpinner" class="spinner"></div>
        </div>
      </form>
    </div>
    <div class="split right">
      <div class="response-header">
        <h2>Response:</h2>
        <button id="copyBtn" class="copy-btn">Copy JSON</button>
      </div>
      <div id="result"></div>
    </div>
    </div>
  </div>
</body>

</html>

<script type="text/javascript">
  let current_endpoint = "";
  let current_response_data = null;
  const hiddenElement = document.getElementById('hiddenData');
  const route_data = JSON.parse(hiddenElement.textContent);
  hiddenElement.remove();
  
  document.addEventListener('DOMContentLoaded', (event) => {
    document.getElementById('apiForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      let formData = new FormData(document.getElementById('apiForm'));
      let obj_param = {};
      for (let [key, value] of formData.entries()) {      
        obj_param[key.slice(6)] = value;      
      }
      obj_param["type"] = "db";

      console.log( obj_param );

      const method = document.getElementById('method').value;
      const endpoint = current_endpoint;
      const body = JSON.stringify(obj_param);    
      const resultElement = document.getElementById('result');
      const spinner = document.getElementById('loadingSpinner');
      spinner.style.display = 'block';

      try {
        const options = {
          method: method,
          headers: {
            'Content-Type': 'application/json'
          }
        };

        if (method !== 'GET' && body) {
          options.body = body;
          options.param = body;
          console.log( body);
        }

        console.log( endpoint, options);
        const response = await fetch(endpoint, options);
        const data = await response.json();
        console.log( data );
        current_response_data = data;
        document.getElementById('copyBtn').style.display = 'block';
        
        const resultElement = document.getElementById('result');
        resultElement.innerHTML = "";
        renderjson.set_show_to_level(3); // 기본으로 펼쳐질 깊이 설정 (예: 3단계)
        renderjson.set_icons('▼ ', '▶ ');
        resultElement.appendChild(renderjson(data));

      } catch (error) {
        //resultElement.textContent = `Error: ${error.message}`;
        console.log( error.message);
      } finally {
        spinner.style.display = 'none';
      }
    });

    document.getElementById('copyBtn').addEventListener('click', () => {
      if (current_response_data) {
        navigator.clipboard.writeText(JSON.stringify(current_response_data, null, 2)).then(() => {
          const btn = document.getElementById('copyBtn');
          const originalText = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => btn.textContent = originalText, 2000);
        });
      }
    });
  });

  

  function endpointclick(cate, api){
    const req_element = document.getElementById('div_request');
    let req_data = route_data[cate][api]["REQUEST_DATA"];
    if( cate == "root"){
      current_endpoint = `/${api}`;
    } else {
      current_endpoint = `/${cate}/${api}`;
    }
    document.getElementById('selectedEndpoint').textContent = current_endpoint;
    
    console.log( current_endpoint );

    let str_html = "";
    Object.keys( req_data ).forEach( param => {
      let bgcolor = req_data[param].type == "number" ? "rgba(255,215,0,0.12)" : "rgba(0,255,71,0.08)";
      str_html += `<div class="input-label">${param} <span class="input-desc">(${req_data[param].desc}, ${req_data[param].type})</span></div>`;
      str_html += `<div><input type="text" class="modern-input" name="input_${param}" value="" id="input_${param}" style="background-color:${bgcolor}"></div>`;
    });
    
    req_element.innerHTML = str_html;
    
    
  }

  function filterEndpoints(category, btn) {
    // 버튼 활성화 상태 변경
    if (btn) {
      document.querySelectorAll('.cate-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }

    const items = document.querySelectorAll('.endpoint-item');
    items.forEach(item => {
      if (category === 'all' || item.getAttribute('data-cate') === category) {
        item.style.display = 'block';
      } else {
        item.style.display = 'none';
      }
    });
  }

</script>